# Gradle
.gradle/
build/
local.properties

# The Gradle wrapper JAR must be committed so CI and fresh clones can build.
# A blanket *.jar rule (as the original generic-Java .gitignore had) silently
# excludes it and leaves ./gradlew unusable on a fresh checkout.
!gradle/wrapper/gradle-wrapper.jar

# Android build outputs
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
release/
.cxx/

# IDEs
.idea/
*.iml
.vs/
.kotlin/

# Logs and crash dumps
*.log
hs_err_pid*
replay_pid*

# Keystores — never commit signing material
*.jks
*.keystore

# OS
.DS_Store
Thumbs.db
