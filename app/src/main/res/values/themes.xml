<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Gamehost does not depend on AppCompat, so this extends a platform theme.
        Compose Material3 provides the actual styling; this exists only so the window
        starts with the right background and no action bar, avoiding a white flash
        before the first frame.
    -->
    <style name="Theme.Gamehost" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
